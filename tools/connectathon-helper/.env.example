# .env.example（FHIR 聯測松輔助工具設定範本）
#
# 用法：複製成 .env 後填入實際值。.env 已被 .gitignore 排除，請勿進版控。
# 每個欄位後方註明對應的測試步驟，方便對照。

# ───────────────────────────────
# Step 10：X-Participant-Token（TWCAT Proxy 產生）
# ───────────────────────────────
# 現場手動取得後貼入這個即可；若日後有 Proxy API 再用 PROXY 欄位。
TWCAT_PARTICIPANT_TOKEN=
TWCAT_PROXY_BASE_URL=

# ───────────────────────────────
# Step 15：Keycloak OAuth（取得 access_token）
# ───────────────────────────────
# grant 兩種都支援：client_credentials（目前已驗證可行）或 password（大會 UserID/密碼）。
KEYCLOAK_GRANT_TYPE=client_credentials
KEYCLOAK_TOKEN_ENDPOINT=https://twcat-oauthsrv.dicom.org.tw/realms/twcat2026/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=hapifhir
KEYCLOAK_CLIENT_SECRET=
# 僅 password grant 需要：
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=

# ───────────────────────────────
# Step 120 / 230：大會 FHIR 主機（Bundle 上傳目標）
# ───────────────────────────────
FHIR_BASE_URL=https://twcat-fhirsrv.dicom.org.tw/fhir
# Step 230 需額外取得 Proxy 連結
FHIR_PROXY_BASE_URL=

# ───────────────────────────────
# Step 20：meta.profile 連結（多個用逗號區隔）
# ───────────────────────────────
META_PROFILE_URLS=

# ───────────────────────────────
# Step 130 / 240：FHIRfox 驗證（純紀錄；工具不自動操作）
# ───────────────────────────────
FHIRFOX_VALIDATOR_URL=

# ───────────────────────────────
# Step 300：一站式 validator（督察員複測）
# ───────────────────────────────
ONESTOP_VALIDATOR_URL=

# ───────────────────────────────
# Gazelle 平台（純紀錄；不自動登入）
# ───────────────────────────────
GAZELLE_BASE_URL=https://twcat-gazelle.dicom.org.tw
# Step 200 申請抽驗時需告知；可由參數帶入或寫在這
TEST_INSTANCE_ID=

# ───────────────────────────────
# Step 30：產品 UI 截圖目標（你自己的產品，例如 RxFHIR dev）
# ───────────────────────────────
PRODUCT_UI_URL=http://localhost:5173

# ───────────────────────────────
# 輸出設定（截圖與報告）
# ───────────────────────────────
SCREENSHOT_DIR=./output/screenshots
REPORT_DIR=./output/reports
# 截圖檔名格式參考：step_{編號}_{時間戳}.png
